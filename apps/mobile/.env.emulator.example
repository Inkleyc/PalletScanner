# Copy to .env.emulator.local and replace every placeholder with a dedicated
# non-production value. Never put service-role or provider secret keys here.
EXPO_PUBLIC_APP_ENVIRONMENT=emulator
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_NON_PRODUCTION_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_NON_PRODUCTION_PUBLISHABLE_KEY
EXPO_PUBLIC_AI_API_BASE_URL=https://YOUR_NON_PRODUCTION_BACKEND.example.com
EXPO_PUBLIC_DASHBOARD_URL=https://YOUR_NON_PRODUCTION_DASHBOARD.example.com
EXPO_PUBLIC_ENABLE_TEST_MODE=false
EXPO_PUBLIC_ENABLE_DEMO_INVENTORY=false
