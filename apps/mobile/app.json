{
  "expo": {
    "name": "PalletFlip",
    "slug": "PalletScanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "palletscanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coltoninkley.palletscanner",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "PalletFlip uses the camera to scan barcodes and photograph inventory.",
        "NSPhotoLibraryUsageDescription": "PalletFlip uses your photo library to attach product photos to inventory listings.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.coltoninkley.palletscanner",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PalletFlip to scan barcodes and take product photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PalletFlip to attach product photos from your library.",
          "cameraPermission": "Allow PalletFlip to take product photos."
        }
      ],
      "expo-secure-store",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36973777-f009-4dd0-ba11-8bd1f7b0c983"
      }
    },
    "owner": "colton.inkley",
    "updates": {
      "url": "https://u.expo.dev/36973777-f009-4dd0-ba11-8bd1f7b0c983"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
