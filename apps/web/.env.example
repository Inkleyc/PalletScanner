# Web app build-time configuration.
# Local development: copy to ".env" and fill in (never commit real values
# beyond the client-safe publishable key, which ships in the bundle anyway).
# Preview hosting (PF-SCOPE-015) sets the same variables in the host's
# dashboard; VITE_AI_API_BASE_URL points the hosted build at the deployed
# backend instead of the local Vite proxy.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_AI_API_BASE_URL=https://palletscanner-ebay-api.onrender.com
