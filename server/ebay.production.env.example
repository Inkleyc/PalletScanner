# EBAY_ENVIRONMENT has NO default: production is only ever reached by
# this explicit setting (PF-SCOPE-007). An unset value makes the server
# refuse to start instead of silently running production.
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

EBAY_MERCHANT_LOCATION_KEY=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=

# Leave blank to use eBay Taxonomy suggestions dynamically.
EBAY_CATEGORY_ID=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_LOCALE=en-US
EBAY_SERVER_PORT=8787

# Production API security.
PALLETSCANNER_AUTH_MODE=jwt
PALLETSCANNER_IDENTITY_PROVIDER=supabase
# Session tokens are verified against the Supabase project's published
# signing keys (JWKS via SUPABASE_URL below) — no shared secret is needed
# for current ES256 tokens (PF-SCOPE-021). PALLETSCANNER_JWT_SECRET is
# only for legacy HS256 tokens and may be left unset.
PALLETSCANNER_JWT_SECRET=
EBAY_TOKEN_ENCRYPTION_KEY=
# Production requires a specific origin (PF-SCOPE-007). "*" or an unset
# value makes the server refuse to start; "*" is only a sandbox/local default.
PALLETSCANNER_ALLOWED_ORIGIN=https://app.example.com
PALLETSCANNER_LISTING_RATE_LIMIT_PER_MINUTE=20
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# AI is deferred/off by default (PF-D-011). The AI key below is required
# by the production readiness check ONLY when PALLETSCANNER_AI_ENABLED=true.
# Re-enabling AI requires a separately approved scope; leave the flag
# false (and the key blank) until then.
PALLETSCANNER_AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
PALLETSCANNER_AI_TIMEOUT_MS=90000

# Mobile/web public configuration belongs in the app build environment.
# EXPO_PUBLIC_EBAY_API_BASE_URL=https://api.example.com
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Mobile and web apps obtain the user's JWT at runtime after sign-in. Never put
# a shared backend credential or AI provider key in an EXPO_PUBLIC variable.
