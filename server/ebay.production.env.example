EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

EBAY_MERCHANT_LOCATION_KEY=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=

# Leave blank to use eBay Taxonomy suggestions dynamically.
EBAY_CATEGORY_ID=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_LOCALE=en-US
EBAY_SERVER_PORT=8787

# Production API security.
PALLETSCANNER_AUTH_MODE=jwt
PALLETSCANNER_IDENTITY_PROVIDER=supabase
PALLETSCANNER_JWT_SECRET=
EBAY_TOKEN_ENCRYPTION_KEY=
PALLETSCANNER_ALLOWED_ORIGIN=https://app.example.com
PALLETSCANNER_LISTING_RATE_LIMIT_PER_MINUTE=20
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Mobile/web public configuration belongs in the app build environment.
# EXPO_PUBLIC_EBAY_API_BASE_URL=https://api.example.com
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Mobile and web apps obtain the user's JWT at runtime after sign-in. Never put
# a shared backend credential or AI provider key in an EXPO_PUBLIC variable.
