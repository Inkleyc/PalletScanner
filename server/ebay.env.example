# Copy the values you receive from eBay into your root .env file.
# This file is just a checklist/template for the local server.
#
# Settled defaults (PF-SCOPE-007):
# - EBAY_ENVIRONMENT has NO default: it must be set explicitly to
#   "sandbox" or "production". An unset value makes the server refuse to
#   start instead of silently running production. Use "sandbox" locally.
# - CORS: PALLETSCANNER_ALLOWED_ORIGIN defaults to "*" ONLY for
#   sandbox/local runs. Production requires a specific origin and the
#   server refuses to start with "*" or an unset origin.
# - AI is deferred/off by default. An AI provider key is required only
#   when PALLETSCANNER_AI_ENABLED=true (see below); AI reactivation
#   requires a separately approved scope (PF-D-011).

EBAY_ENVIRONMENT=sandbox

# App credentials
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

# Selling configuration
EBAY_MERCHANT_LOCATION_KEY=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=

# Optional fallback if taxonomy suggestions fail
EBAY_CATEGORY_ID=

# Local server config
EBAY_SERVER_PORT=8787
EBAY_MARKETPLACE_ID=EBAY_US
PALLETSCANNER_BARCODE_RATE_LIMIT_PER_MINUTE=60
EBAY_CURRENCY=USD
EBAY_LOCALE=en-US
EBAY_SCOPE=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly

# AI is deferred/off by default. Only set these when AI is explicitly
# enabled under a separately approved scope (PF-D-011). Without
# PALLETSCANNER_AI_ENABLED=true, the backend AI endpoint returns 503
# and the production readiness check does not require a key.
PALLETSCANNER_AI_ENABLED=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# App -> backend connection
# For local device testing, use your computer's LAN IP, not localhost.
# Example: http://192.168.1.42:8787
EXPO_PUBLIC_EBAY_API_BASE_URL=
