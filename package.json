{
  "name": "palletscanner-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @palletscanner/mobile",
    "reset-project": "npm run reset-project -w @palletscanner/mobile",
    "android": "npm run android -w @palletscanner/mobile",
    "ios": "npm run ios -w @palletscanner/mobile",
    "web": "npm run web -w @palletscanner/mobile",
    "lint": "npm run lint -w @palletscanner/mobile",
    "ebay-server": "node ./server/ebay-server.mjs",
    "ebay:production-check": "node ./server/production-check.mjs",
    "ebay:generate-secrets": "node ./server/generate-production-secrets.mjs",
    "ebay:generate-test-jwt": "node ./server/generate-test-jwt.mjs",
    "supabase:app-check": "npm run supabase:app-check -w @palletscanner/mobile",
    "web:export": "npm run web:export -w @palletscanner/mobile",
    "web:deploy": "npm run web:deploy -w @palletscanner/mobile",
    "dashboard:dev": "npm run dev -w @palletscanner/web",
    "dashboard:check": "npm run check -w @palletscanner/web",
    "mobile:build:android-preview": "npm run build:android-preview -w @palletscanner/mobile",
    "mobile:build:ios-preview": "npm run build:ios-preview -w @palletscanner/mobile",
    "mobile:build:development": "npm run build:development -w @palletscanner/mobile",
    "check": "npm run lint && npm run web:export && npm run dashboard:check && npm run core:typecheck && npm run api-client:typecheck",
    "core:typecheck": "npm run typecheck -w @palletscanner/core",
    "api-client:typecheck": "npm run typecheck -w @palletscanner/api-client"
  }
}
